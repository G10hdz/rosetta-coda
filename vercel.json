{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/research", "destination": "/evidence", "permanent": false },
    { "source": "/research/", "destination": "/evidence", "permanent": false }
  ],
  "rewrites": [
    { "source": "/evidence", "destination": "/research" },
    { "source": "/evidence/(.*)", "destination": "/research/$1" }
  ],
  "headers": [
    {
      "source": "/artifacts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
