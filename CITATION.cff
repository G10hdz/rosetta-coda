cff-version: 1.2.0
title: "Rosetta Coda"
message: "If you use this software or its artifacts, please cite it as below."
type: software
authors:
  - family-names: "Hernández Ríos"
    given-names: "Mayte Giovanna"
abstract: >-
  A local-first research instrument for generating falsifiable
  phonological hypotheses about sperm-whale codas. Deterministic
  measurements and statistics run before any model interpretation;
  every hypothesis cites resolvable evidence references, alternatives,
  falsifiers, and uncertainty. Not a translator.
url: "https://rosetta-coda.vercel.app"
repository-code: "https://github.com/G10hdz/rosetta-coda"
license: MIT
version: "0.1.0"
identifiers:
  - description: "Sealed research release manifest"
    type: url
    value: "https://rosetta-coda.vercel.app/artifacts/release/manifest.json"
keywords:
  - sperm whale
  - coda
  - bioacoustics
  - phonology
  - reproducible research
